PORT=1910
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
# Optional: token lifetime (default 1d)
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Maximum straight-line distance (km) between a mechanic's saved location and
# a pinned request for the mechanic to see / accept it, and the cap for the
# customer nearby search. Default 25, hard maximum 500.
MECHANIC_MAX_RADIUS_KM=25

# --- Password reset by email (required for "Forgot Password") ---------------
# Without these, POST /api/auth/forgot-password returns 503 and sends nothing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="RoadSafe <no-reply@your-domain.example>"
# Optional: separate secret used to HMAC-hash OTPs (defaults to JWT_SECRET)
OTP_HMAC_SECRET=
# Optional: set to the number of reverse proxies in front of the API (e.g. 1)
# so rate limits use the real client IP. Leave empty if not behind a proxy.
TRUST_PROXY=
